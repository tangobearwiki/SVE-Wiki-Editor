<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Tab 切换 -->
    <RadioGroup
        android:id="@+id/radio_group_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radio_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="删除页面"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radio_move"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="移动页面" />

        <RadioButton
            android:id="@+id/radio_replace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="文本替换" />
    </RadioGroup>

    <!-- 状态 -->
    <TextView
        android:id="@+id/tv_manage_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:textSize="12sp"
        android:textColor="@color/text_secondary" />

    <ProgressBar
        android:id="@+id/progress_bar_manage"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========== 删除页面 ========== -->
            <LinearLayout
                android:id="@+id/layout_delete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选择要删除的本地页面"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <!-- 搜索 + 空间筛选 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <EditText
                        android:id="@+id/et_delete_search"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="搜索页面标题..."
                        android:inputType="text"
                        android:singleLine="true"
                        android:textSize="13sp"
                        android:padding="6dp" />

                    <Spinner
                        android:id="@+id/spinner_delete_namespace"
                        android:layout_width="130dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <!-- 全选 / 清空 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">

                    <Button
                        android:id="@+id/btn_delete_select_all"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="全选"
                        android:textSize="12sp"
                        android:backgroundTint="@color/secondary" />

                    <Button
                        android:id="@+id/btn_delete_clear"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="清空"
                        android:textSize="12sp"
                        android:backgroundTint="@color/text_secondary" />
                </LinearLayout>

                <!-- 删除模式 -->
                <RadioGroup
                    android:id="@+id/radio_group_delete_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginVertical="4dp">

                    <RadioButton
                        android:id="@+id/radio_delete_all"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="本地+云端"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/radio_delete_local"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="仅本地" />

                    <RadioButton
                        android:id="@+id/radio_delete_cloud"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="仅云端" />
                </RadioGroup>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="300dp">
                    <LinearLayout
                        android:id="@+id/ll_delete_pages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <Button
                    android:id="@+id/btn_delete_execute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="执行删除"
                    android:backgroundTint="@color/error_color" />
            </LinearLayout>

            <!-- ========== 移动页面 ========== -->
            <LinearLayout
                android:id="@+id/layout_move"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="移动页面"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="原页面名"
                    android:layout_marginTop="4dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_move_from"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="新页面名"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_move_to"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="移动原因"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_move_reason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="移动页面" />
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox
                    android:id="@+id/cb_move_talk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="同时移动讨论页"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/cb_move_subpages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="同时移动子页面" />

                <Button
                    android:id="@+id/btn_move_execute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="执行移动" />
            </LinearLayout>

            <!-- ========== 文本替换 ========== -->
            <LinearLayout
                android:id="@+id/layout_replace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="文本替换（ReplaceText）"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="查找内容"
                    android:layout_marginTop="4dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_replace_find"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="替换为"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_replace_with"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox
                    android:id="@+id/cb_replace_regex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="使用正则表达式" />

                <CheckBox
                    android:id="@+id/cb_replace_case"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="忽略大小写" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="编辑摘要"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_replace_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="批量替换" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btn_replace_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="搜索匹配页面" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="匹配到的页面："
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="200dp">
                    <LinearLayout
                        android:id="@+id/ll_replace_results"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <Button
                    android:id="@+id/btn_replace_execute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="执行替换"
                    android:enabled="false" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>