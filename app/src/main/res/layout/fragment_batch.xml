<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="批量替换规则"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="每行一条规则，格式：查找内容 -> 替换内容"
        android:textSize="12sp"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/et_rules"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="start"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical"
        android:layout_marginTop="8dp" />

    <CheckBox
        android:id="@+id/cb_ignore_case"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="忽略大小写"
        android:layout_marginTop="4dp" />

    <CheckBox
        android:id="@+id/cb_regex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="使用正则表达式" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="目标页面"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="每行一个页面标题，或使用分类搜索"
        android:textSize="12sp"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="搜索/分类名"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="搜索"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="start"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_start_batch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="开始批量替换"
        android:backgroundTint="@color/accent_orange" />

    <ProgressBar
        android:id="@+id/batch_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_batch_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textSize="12sp"
        android:textColor="@color/text_secondary" />

</LinearLayout>